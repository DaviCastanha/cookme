# Sem as variáveis do Google, o app roda em "modo local" (dados só no navegador).
# URL pública da aplicação (sem barra no final). Em desenvolvimento: http://localhost:3000
APP_URL=http://localhost:3000

# Credenciais do OAuth Client (tipo "Aplicativo da Web") criado no Google Cloud Console.
# Veja docs/GOOGLE_SETUP.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Segredo usado para criptografar o cookie de sessão (mínimo 32 caracteres).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# E-mail de contato exibido na Política de Privacidade e nos Termos (página pública).
NEXT_PUBLIC_CONTACT_EMAIL=
